{
  "name": "social-casino-index",
  "private": true,
  "version": "0.1.0",
  "description": "Static site build for socialcasinoindex.com (11ty, flat HTML output to docs/ for GitHub Pages).",
  "scripts": {
    "monitor:run": "node scripts/monitor/run.mjs",
    "monitor:test": "node --test scripts/monitor/test.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:social-card": "node scripts/build-social-card.mjs --from-source",
    "build:csv": "node scripts/build-csv.mjs",
    "build:css": "tailwindcss -i src/css/input.css -o src/assets/site.css --minify",
    "build": "npm run build:icons && npm run build:csv && npm run build:css && eleventy && npm run sitemap:validate",
    "serve": "npm run build:css && eleventy --serve",
    "content:validate": "node scripts/validate-content.mjs",
    "content:touch": "node scripts/content-touch.mjs",
    "analytics:validate": "node --test scripts/test-analytics.mjs",
    "sitemap:validate": "node scripts/validate-sitemap.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "release": "npm run content:validate && npm run analytics:validate && npm run build && npm run seo:validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@phosphor-icons/web": "^2.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.1.2",
    "daisyui": "^5.7.32",
    "tailwindcss": "^4.3.3"
  },
  "type": "module"
}
