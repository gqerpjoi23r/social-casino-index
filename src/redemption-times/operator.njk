---
pagination:
  data: operators
  size: 1
  alias: operator
permalink: "/redemption-times/{{ operator.slug }}/index.html"
layout: base.njk
tags: ["operatorPages"]
eleventyComputed:
  title: "{{ operator.name }} Redemption Time, Methods and Minimum"
  description: "{{ operator.name }} redemption methods, published payout timing, minimum, verification, availability and source-linked terms."
---
<main><article class="wrap py-10">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/redemption-times/">Redemption times</a></li><li><span aria-current="page">{{ operator.name }}</span></li></ol></nav>
  <p class="eyebrow">Operator record · Verified {{ operator.verifiedAt | readableDate }}</p>
  <h1 class="page-title">{{ operator.name }} Redemption Time and Player Terms</h1>
  <p class="lede">{{ operator.summary }}</p>
  <div class="answer-first">
    <span class="af-label">Best for</span>
    <p><strong>{{ operator.bestFor }}.</strong></p>
    <p>Published timing: {{ operator.publishedEstimate }}. Minimum: {{ operator.minRedemption }}. Methods: {{ operator.methods }}.</p>
  </div>
  <h2>Player value snapshot</h2>
  <dl class="detail-grid">
    <div><dt>Current offer</dt><dd>{{ operator.offer }}</dd></div>
    <div><dt>Daily value</dt><dd>{{ operator.dailyValue }}</dd></div>
    <div><dt>Package value</dt><dd>{{ operator.packageValue }}</dd></div>
    <div><dt>Games</dt><dd>{{ operator.games }}</dd></div>
    <div><dt>First redemption</dt><dd>{{ operator.firstRedemption }}</dd></div>
    <div><dt>Repeat redemption</dt><dd>{{ operator.repeatRedemption }}</dd></div>
    <div><dt>Playthrough</dt><dd>{{ operator.playthrough }}</dd></div>
    <div><dt>Identity checks</dt><dd>{{ operator.kyc }}</dd></div>
    <div><dt>Limits</dt><dd>{{ operator.limits }}</dd></div>
    <div><dt>Support</dt><dd>{{ operator.support }}</dd></div>
  </dl>
  <h2>Strengths and tradeoffs</h2>
  <div class="grid gap-5 sm:grid-cols-2">
    <div><h3>Strengths</h3><ul class="tick-list">{% for item in operator.strengths %}<li class="good">{{ item }}</li>{% endfor %}</ul></div>
    <div><h3>Tradeoffs</h3><ul class="tick-list">{% for item in operator.tradeoffs %}<li class="bad">{{ item }}</li>{% endfor %}</ul></div>
  </div>
  <h2>Availability</h2>
  <p>{{ operator.availability }}</p>
  {% if operator.restrictedStates.length %}<p><strong>Restricted states in the reviewed source:</strong> {{ operator.restrictedStates | join(", ") }}.</p>{% endif %}
  {% if operator.partner %}
  <div class="cta-box" data-cta-operator="{{ operator.slug }}">
    <p class="cta-title">Check {{ operator.name }}</p>
    <p class="cta-msg">Confirm your state and the live offer before creating an account.</p>
    <a class="cta-btn" href="/go/{{ operator.slug }}/">Visit {{ operator.name }} <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
  </div>
  {% endif %}
  <h2>Sources and verification</h2>
  <p>Status: <span class="badge {% if operator.verificationStatus == 'verified' %}complete{% else %}pending{% endif %}">{{ operator.verificationLabel }}</span>. Last checked {{ operator.verifiedAt | readableDate }}. Fields that could not be confirmed are labeled as not publicly verified.</p>
  <ol class="sources">{% for source in operator.sources %}<li>{{ source.label }}. <a href="{{ source.url }}" rel="noopener">{{ source.url | replace("https://", "") }}</a>. <span class="accessed">Accessed {{ source.accessed | readableDate }}.</span></li>{% endfor %}</ol>
  <p class="byline mt-8"><a href="/redemption-times/">Compare all operators</a> · <a href="/methodology/">Methodology</a> · <a href="/disclosure/">Affiliate disclosure</a></p>
</article></main>
