---
pagination:
  data: operators
  size: 1
  alias: operator
permalink: "/redemption-times/{{ operator.slug }}/index.html"
layout: base.njk
tags: ["operatorPages"]
ogType: "article"
eleventyComputed:
  title: "{{ pageTitle }}"
  description: "How long {{ operator.name }} redemptions take, the minimum SC to redeem, payout methods and what pending or approved status means, from dated operator sources."
---
{% from "benefit-row.njk" import evidence %}
<main><article class="wrap py-10">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/redemption-times/">Redemption times</a></li><li><span aria-current="page">{{ operator.name }}</span></li></ol></nav>
  <p class="eyebrow">Operator record · Published redemption terms</p>
  <h1 class="page-title">{{ operator.name }} Redemption Time, Minimum and Methods</h1>
  {% if current.product.lastCheckedAt %}<p class="benefit-source">Checked <time datetime="{{ current.product.lastCheckedAt }}">{{ current.product.lastCheckedAt | readableDate }}</time> from operator sources</p>{% endif %}
  <div class="answer-first" id="quick-answer"><span class="af-label">Quick answer</span><p>{{ answer.summary | escape }}</p></div>
  <p class="lede">{{ current.product.summary | escape }}</p>
  <p class="benefit-policy">Operator-published terms, not measured payouts. Gold Coins are entertainment credits, not redeemable Sweeps Coins.</p>
  {% if current.product.rewardTypes.length %}<p class="text-sm">{{ current.product.rewardTypes | join(" · ") | escape }}</p>{% endif %}
  <div class="benefit-detail-grid">
  {% for key, label in current.product.labels %}
    {% if current.product[key] %}<section data-product-metric="{{ key }}"><h2>{{ label }}</h2>
      {% if key == "minimum" %}{% for value in current.product.minima %}{{ evidence(value, true) }}{% endfor %}
      {% else %}{{ evidence(current.product[key], true) }}{% endif %}
    </section>{% endif %}
  {% endfor %}
  </div>
  {% if current.product.additionalOffers.length %}
  <section id="additional-offers"><h2>More {{ operator.name }} offers</h2>
    {% for offer in current.product.additionalOffers %}<section class="operator-offer"><h3>{{ offer.kind | replace("_", " ") | capitalize }}</h3>{{ evidence(offer, true) }}</section>{% endfor %}
  </section>
  {% endif %}
  {% if not current.product.benefitCount %}<p>Offer evidence is being checked. Missing collected values do not establish that an operator lacks an offer.</p>{% endif %}
  <nav class="benefit-nav" aria-label="Bonus benchmarks">{% for benchmark in benchmarks.benchmarks %}{% if current.metrics[benchmark.id] %}<a href="{{ benchmark.url }}">Compare {{ benchmark.title | lower }}</a>{% endif %}{% endfor %}</nav>
  <section id="redemption-answer">
    <h2>Redemption methods and requirements</h2>
    {% if current.product.methods.length %}<p>Published methods: {{ current.product.methods | join(", ") | escape }}.</p>{% endif %}
    {% if redemption.methodRows.length %}
    <h3 id="redemption-by-method">{{ operator.name }} redemption time and minimum by method</h3>
    <div class="table-scroll"><table class="data method-timing"><thead><tr><th scope="col">Method</th><th scope="col">Minimum</th><th scope="col">Published time</th><th scope="col">Source</th></tr></thead>
    <tbody>{% for row in redemption.methodRows %}<tr><th scope="row">{{ row.method }}</th><td>{% if row.minima.length %}{{ row.minima | join(", ") | escape }}{% else %}Not published{% endif %}</td><td>{% if row.times.length %}{% for time in row.times %}<strong>{{ time.label | escape }}</strong> <span class="benefit-note">{{ time.stage }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}{% else %}Not published{% endif %}</td><td>{% for source in row.sources %}<a class="benefit-source" href="{{ source.url | escape }}" rel="noopener">{{ source.observedAt | readableDate }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}</tbody></table></div>
    <p class="text-sm">Times cover different stages, such as approval or delivery after approval. They are not measured payout times.</p>
    {% endif %}
    {% for policy in current.product.policies %}
      {% if policy.recordId != current.product.redemption.recordId %}<section data-policy-record="{{ policy.recordId }}"><h3>{{ policy.field | replace("_", " ") | capitalize }}</h3>{{ evidence(policy, true) }}</section>{% endif %}
    {% endfor %}
    {% if current.product.verification.length %}<h3>Identity checks</h3>{% for requirement in current.product.verification %}{{ evidence(requirement, true) }}{% endfor %}{% endif %}
    {% if current.product.fees.length %}<h3>Fees</h3>{% for fee in current.product.fees %}{{ evidence(fee, true) }}{% endfor %}{% endif %}
  </section>
  <section id="redemption-status">
    <h2>{{ operator.name }} redemption status meanings</h2>
    {% for item in redemption.statuses %}<h3>{{ item.status }}</h3><p>{{ item.meaning }}{% if item.published %} {{ item.published | escape }}{% endif %}</p>{% endfor %}
    <p class="text-sm">Status names vary between operators. Your account redemption history shows the exact label.</p>
  </section>
  <h2>Funded test status</h2>
  <p>
{% if operator.testStatus == "completed" %}
    <span class="badge completed"><i class="ph ph-seal-check" aria-hidden="true"></i> Completed funded test</span>
{% elif operator.testStatus == "pending" %}
    <span class="badge pending"><i class="ph ph-hourglass-medium" aria-hidden="true"></i> Funded test pending</span>
{% else %}
    <span class="badge nottested"><i class="ph ph-clock-clockwise" aria-hidden="true"></i> Not tested yet</span>
{% endif %}
  </p>
{% if operator.testStatus == "completed" and operator.observedResult %}
  <p>We funded an account and timed a real redemption: {{ operator.observedResult.type }} redemption by {{ operator.observedResult.method }}, requested {{ operator.observedResult.requestedAt | readableDate }}, received {{ operator.observedResult.receivedAt | readableDate }} ({{ operator.observedResult.businessDays }} business days){% if operator.observedResult.notes %}. {{ operator.observedResult.notes }}{% endif %}.</p>
  <p class="text-sm text-base-content/60">Observed figures come from our own funded test and are shown separately from the operator's published terms below. A single test does not make a ranking; see the <a href="/methodology/">methodology</a>.</p>
{% elif operator.testStatus == "pending" %}
  <p>A funded redemption test with {{ operator.name }} is pending. No measured result is available. <a href="/methodology/">How funded testing works</a>.</p>
{% else %}
  <p>We have not funded an account with {{ operator.name }} yet. Every figure on this page is a published term from the operator's own documents, not a measured result. <a href="/methodology/">How funded testing works</a>.</p>
{% endif %}
  <h2 id="availability">Availability</h2>
  <p>{{ operator.availability }}</p>
  {% if operator.restrictedStates.length %}<p><strong>Existing exclusions retained by the site's state gate:</strong> {{ operator.restrictedStates | join(", ") }}. This list was not reverified in the offer review and does not establish availability elsewhere.</p>{% endif %}
  <p>Check the site's offer policy and separate legal-source notes in the <a href="/availability/#closed-states">state availability index</a>. Operator acceptance does not establish legality.</p>
  <h2>Compare payout methods</h2>
  <p>For the request process, read <a href="/guides/how-to-redeem-sweeps-coins/">how to redeem Sweeps Coins</a>.</p>
  <p>Compare the methods in detail: <a href="/guides/redemption-methods/bank-transfer/">bank transfer</a>, <a href="/guides/redemption-methods/gift-card/">gift card</a> and <a href="/guides/redemption-methods/crypto/">cryptocurrency</a>, or read the <a href="/research/sweepstakes-casino-redemption-times/">full redemption-time research</a>.</p>
  {% if operator.visitDestination %}
  <div class="cta-box" data-cta-operator="{{ operator.slug }}">
    <p class="cta-title">Check {{ operator.name }}</p>
    <p class="cta-msg">Confirm your state and the live offer before creating an account.</p>
    <a class="cta-btn" href="/go/{{ operator.slug }}/" rel="sponsored noopener">Visit {{ operator.name }} <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
  </div>
  {% endif %}
  <h2 id="sources">Sources and verification</h2>
  <p>
    {% if current.product.lastCheckedAt %}<span class="badge nottested"><i class="ph ph-clock-clockwise" aria-hidden="true"></i> Last attempted check {{ current.product.lastCheckedAt | readableDate }}</span>{% endif %}
  </p>
  <p class="text-sm text-base-content/60">The review date records the evidence check, not a guarantee that every field was verified. Some public pages were retrieved from a US location to resolve regional access blocks; this does not establish player eligibility. Blocked pages document an evidence gap and do not support numeric claims.</p>
  <ol class="sources">{% for source in current.product.sources %}<li id="source-{{ source.id }}"><a href="{{ source.url }}" rel="noopener">{{ source.url | replace("https://", "") }}</a>. <span class="accessed">Checked {{ source.checkedAt | readableDate }}. {{ source.status | replace("_", " ") }}.</span></li>{% endfor %}</ol>
  {% if current.product.history.length or current.product.expiredOffers.length %}
  <section id="change-history"><h2>Offer history</h2>
    {% for change in current.product.history %}<p><time datetime="{{ change.at }}">{{ change.at | readableDate }}</time>: {{ change.field | replace("_", " ") }} value changed. <a href="{{ change.sourceUrl | escape }}">Operator source</a>.</p>{% endfor %}
    {% for offer in current.product.expiredOffers %}<p>{{ offer.name | escape }}: offer ended <time datetime="{{ offer.ended }}">{{ offer.ended | readableDate }}</time>. <a href="{{ offer.sourceUrl | escape }}">Historical source</a>. Not included in current comparisons.</p>{% endfor %}
  </section>
  {% endif %}
  <section id="questions"><h2>{{ operator.name }} questions</h2>
    {% for faq in current.product.faqs %}<section><h3>{{ faq.question | escape }}</h3><p>{{ faq.answer | escape }}</p><p class="benefit-source"><a href="{{ faq.value.sourceUrl | escape }}">Operator source</a> · Observed <time datetime="{{ faq.value.observedAt }}">{{ faq.value.observedAt | readableDate }}</time></p></section>{% endfor %}
    {% if not current.product.redemption %}{% set timingFaq = answer.faqs | last %}<section><h3>{{ timingFaq.question | escape }}</h3><p>{{ timingFaq.answer | escape }}</p></section>{% endif %}
    {% for faq in redemption.faqs %}<section><h3>{{ faq.question | escape }}</h3><p>{{ faq.answer | escape }}</p></section>{% endfor %}
  </section>
  <nav class="benefit-nav" aria-label="Related answers"><a href="/bonuses/sweepstakes-casinos-under-50-sc-redemption/">Casinos with redemptions under 50 SC</a><a href="/redemption-times/by-method/">Payout times by method</a>{% for comparison in benchmarks.comparisons %}{% if operator.slug in comparison.slug %}<a href="{{ comparison.url }}">{{ comparison.title }}</a>{% endif %}{% endfor %}</nav>
  <p class="byline mt-8"><a href="/redemption-times/">Compare all operators</a> · <a href="/methodology/">Methodology</a> · <a href="/disclosure/">Affiliate disclosure</a></p>
</article></main>
