<!doctype html>
<html lang="en" class="scroll-smooth" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ site.name }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- if noindex %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/social-card.jpg">
<meta property="og:image:secure_url" content="{{ site.url }}/assets/social-card.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Social Casino Index: independent research on US sweepstakes casino redemption times and payout methods.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}/assets/social-card.jpg">
<meta name="twitter:image:alt" content="Social Casino Index: independent research on US sweepstakes casino redemption times and payout methods.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/phosphor/style.css">
<script>document.documentElement.classList.add('js');</script>
<script src="/assets/analytics.js" defer></script>
{% if jsonld %}
<script type="application/ld+json">{{ jsonld | json | safe }}</script>
{% endif %}
</head>
<body class="bg-base-100 font-sans text-[17px] leading-relaxed text-base-content antialiased">

<div class="state-banner js-only" data-state-banner hidden>
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-6 py-2">
    <p class="m-0 flex items-center gap-2 text-[13.5px] text-base-content/70">
      <i class="ph ph-map-pin text-base text-brand" aria-hidden="true"></i>
      <span data-state-banner-text>Sweepstakes casino availability varies by state. Select yours for accurate offers.</span>
    </p>
    <div class="flex items-center gap-2">
      <label class="sr-only" for="state-picker-banner">Your state</label>
      <select id="state-picker-banner" class="select select-bordered select-sm w-auto" data-state-picker>
        {% for s in states %}<option value="{{ s.code }}"{% if not s.code %} disabled selected{% endif %}>{{ s.name }}</option>{% endfor %}
      </select>
      <button type="button" class="btn btn-ghost btn-sm btn-square" data-state-banner-close aria-label="Dismiss state banner"><i class="ph ph-x" aria-hidden="true"></i></button>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-3">
    <a class="flex items-center gap-2.5 font-serif text-[22px] font-semibold text-base-content no-underline" href="/">
      <i class="ph ph-crown-simple flex-none text-[30px] leading-none text-accent" aria-hidden="true"></i>
      {{ site.name }}
    </a>
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[14.5px] text-base-content/60" aria-label="Main">
      <a class="no-underline hover:text-brand" href="/redemption-times/">Redemption times</a>
      <a class="no-underline hover:text-brand" href="/guides/sweepstakes-casino-redemption-methods/">Payout methods</a>
      <a class="no-underline hover:text-brand" href="/guides/">Guides</a>
      <a class="no-underline hover:text-brand" href="/methodology/">Methodology</a>
      <a class="no-underline hover:text-brand" href="/availability/">State availability</a>
      <a class="no-underline hover:text-brand" href="/about/">About</a>
      <a class="no-underline hover:text-brand" href="/authors/alex-rowan/">Author</a>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="mt-14 border-t border-base-300 bg-base-200 text-[14.5px] text-base-content/70">
  <div class="mx-auto w-full max-w-5xl px-6 py-10">
    <span class="age-badge">21+ or 18+ depending on your state</span>
    <h2 class="mb-2.5 font-serif text-xl font-semibold text-base-content">About this site</h2>
    <p class="mb-3 max-w-xl">Social Casino Index compares what US sweepstakes casinos give players: offers, games, redemption methods, payout timing, minimums and restrictions. Every operator record is dated and source-linked.</p>
    <p class="mb-3 max-w-xl"><strong class="font-semibold text-base-content">Affiliate disclosure.</strong> Some links on this site are affiliate links. If you sign up through one, we may be paid a commission at no cost to you. Compensation never affects a rating, a ranking or a measured figure. Read the <a class="text-brand" href="/disclosure/">full disclosure</a>.</p>
    <p class="mb-3 max-w-xl"><strong class="font-semibold text-base-content">Not legal or tax advice.</strong> State law in this category changes frequently. Confirm the current rules for your state, and speak to a licensed attorney or CPA about your own situation.</p>
    <p class="mb-3 max-w-xl"><strong class="font-semibold text-base-content">Play responsibly.</strong> If gambling stops being fun, call 1-800-GAMBLER or text 800GAM to 800662. Support is free, confidential and available around the clock.</p>
    <p class="fine mb-3">
      <a class="text-base-content/70 no-underline hover:text-brand" href="/guides/">Guides</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/redemption-times/">Redemption times</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/taxes/">Taxes</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/about/">About</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/methodology/">Methodology</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/disclosure/">Disclosure</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/disclaimer/">Disclaimer</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/privacy/">Privacy</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/availability/">State availability</a> ·
      <a class="text-base-content/70 no-underline hover:text-brand" href="/authors/alex-rowan/">Alex Rowan</a>
    </p>
    <p class="fine mb-3">Hero photo via <a class="text-base-content/60 underline hover:text-brand" href="https://unsplash.com/" rel="noopener">Unsplash</a>.</p>
    <p class="fine">&copy; {{ site.buildYear }} {{ site.legalName }}, a Delaware limited liability company. {{ site.name }} is a publication of {{ site.legalName }}.</p>
  </div>
</footer>

<script src="/assets/eligibility.js" defer></script>
</body>
</html>
