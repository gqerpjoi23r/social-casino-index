{% if playerAnswers.length %}
<section class="player-answers" aria-labelledby="player-answers-heading">
  <h2 id="player-answers-heading" class="section-title">Specific comparisons</h2>
{% for group in playerAnswers %}
  <section id="{{ group.id }}" aria-labelledby="{{ group.id }}-heading">
    <h3 id="{{ group.id }}-heading">{{ group.title | escape }}</h3>
    <ul>{% for row in group.rows %}
      <li>{{ row.text | escape }} <a href="{{ row.sourceUrl | escape }}" rel="noopener">{{ row.name | escape }} source, <time datetime="{{ row.observedAt | escape }}">{{ row.observedAt | readableDate }}</time></a></li>
    {% endfor %}</ul>
  </section>
{% endfor %}
</section>
{% endif %}
