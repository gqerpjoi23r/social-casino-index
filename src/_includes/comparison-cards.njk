<div class="benchmark" data-comparison>
{% for section in comparisonSections %}
  <section class="benchmark-section" id="benchmark-{{ section.id }}" aria-labelledby="heading-{{ section.id }}">
    <h3 id="heading-{{ section.id }}"><i class="ph ph-{{ section.icon }}" aria-hidden="true"></i> {{ section.title }}</h3>
{% for group in section.groups %}{% if group.rows.length %}
    <table class="benchmark-table">
      <caption class="{% if not group.title %}sr-only{% endif %}">{{ group.title or section.title }}</caption>
      <thead><tr><th scope="col">Casino</th><th scope="col">{{ group.title or section.title }}</th></tr></thead>
      <tbody>{% for row in group.rows %}
        <tr data-operator="{{ row.slug | escape }}">
          <th scope="row"><a class="benchmark-brand" href="/redemption-times/{{ row.slug | escape }}/">
            {% for brand in operators %}{% if brand.slug == row.slug %}<img class="operator-favicon" src="/assets/favicons/{{ brand.slug }}{{ brand.faviconExt }}" width="32" height="32" alt="" loading="lazy" decoding="async">{% endif %}{% endfor %}
            <span>{{ row.name | escape }}</span>
          </a></th>
          <td>
            <strong class="benchmark-value">{{ row.value | escape }}</strong>
{% if row.note %}<p class="benchmark-note">{{ row.note | escape }}</p>{% endif %}
{% if row.promoCode %}<p class="benchmark-note">Code: <strong>{{ row.promoCode | escape }}</strong></p>{% endif %}
            <a class="benchmark-source" href="{{ row.sourceUrl | escape }}" rel="noopener">Observed <time datetime="{{ row.observedAt | escape }}">{{ row.observedAt | readableDate }}</time></a>
{% if row.conditions.length %}<details><summary>Offer terms<span class="sr-only"> for {{ row.name | escape }}</span></summary>
              <ul>{% for condition in row.conditions %}<li>{{ condition | escape }}</li>{% endfor %}</ul>
            </details>{% endif %}
          </td>
        </tr>
{% endfor %}</tbody>
    </table>
{% endif %}{% endfor %}
  </section>
{% endfor %}
</div>
<footer class="benchmark-policy">
  <p>Advertised terms, observed on the dates shown. Welcome: highest advertised SC total. First purchase: most immediate SC per dollar. Redemption: lowest stated minimum for each method. Casinos listed alphabetically.</p>
  <p>Amounts come from the latest saved snapshot of each source. Availability and operator terms apply; these are not tested payouts.</p>
  <p><a href="/updates/numeric.json">All numeric records</a> &middot; <a href="/updates/data.json">Observation history</a> &middot; <a href="/methodology/">Methodology</a></p>
</footer>
{% if playerAnswers.length %}
<section class="player-answers" aria-labelledby="player-answers-heading">
  <h2 id="player-answers-heading" class="section-title">Sweepstakes casino comparisons</h2>
  <p>Based on the advertised amounts above. Direct comparisons cover the metrics available for both casinos.</p>
{% for group in playerAnswers %}
  <section id="{{ group.id }}" aria-labelledby="{{ group.id }}-heading">
    <h3 id="{{ group.id }}-heading">{{ group.title | escape }}</h3>
    <ul>{% for row in group.rows %}
      <li>{{ row.text | escape }} <a href="{{ row.sourceUrl | escape }}" rel="noopener">{{ row.name | escape }} source, <time datetime="{{ row.observedAt | escape }}">{{ row.observedAt | readableDate }}</time></a></li>
{% endfor %}</ul>
  </section>
{% endfor %}
</section>
{% endif %}
