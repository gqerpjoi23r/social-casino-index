{% macro cell(value) %}
{% if value %}
  <strong class="toplist-value">{{ value.label | escape }}</strong>
  {% if value.note %}<span class="toplist-note">{{ value.note | escape }}</span>{% endif %}
{% else %}<span class="toplist-unknown">Not verified</span>{% endif %}
{% endmacro %}
<section class="toplist" id="all-operators" aria-labelledby="leaderboard-heading">
  <div class="toplist-heading">
    <div class="toplist-title"><h2 id="leaderboard-heading">Compare offers <span class="toplist-count">{{ benchmarks.toplist.homepageRows.length }}</span></h2>
    {% if benchmarks.toplist.lastCheckedAt %}<span class="toplist-checked">Last checked <time datetime="{{ benchmarks.toplist.lastCheckedAt }}">{{ benchmarks.toplist.lastCheckedAt | readableDate }}</time></span>{% endif %}</div>
    <div class="toplist-controls">
      <label class="home-state"><i class="ph ph-map-pin" aria-hidden="true"></i><span class="sr-only">Your state</span>
        <select data-state-picker aria-label="Your state">{% for s in states %}<option value="{{ s.code }}"{% if not s.code %} disabled selected{% endif %}>{{ s.name if s.code else "Your state" }}</option>{% endfor %}</select>
      </label>
      <label class="toplist-sort" hidden><span class="sr-only">Sort by</span>
        <select id="toplist-sort">{% for sort in benchmarks.toplist.sorts %}
          <option value="{{ sort.key }}"{% if sort.key == "welcome" %} selected{% endif %}{% if not sort.available %} disabled{% endif %}>{{ sort.label }}</option>
        {% endfor %}</select>
      </label>
    </div>
  </div>
  <p id="toplist-sort-status" class="sr-only" aria-live="polite">Sorted by highest free signup offer.</p>
  <ol class="toplist-list" data-active-sort="welcome">
    {% for operator in benchmarks.toplist.homepageRows %}
    <li class="toplist-item" data-operator="{{ operator.slug }}" data-sort="{{ {slug: operator.slug, name: operator.name, sortValues: operator.sortValues} | json | escape }}">
      <div class="toplist-identity">
        <h3 class="toplist-name"><a class="benefit-brand" href="{{ operator.url }}">{{ operator.name | escape }}</a></h3>
        <div class="toplist-mark"><span class="toplist-position" aria-label="List position">{{ operator.position }}</span>
          {% if operator.favicon %}<img src="{{ operator.favicon }}" alt="" width="36" height="36">{% else %}<span class="operator-monogram" aria-hidden="true">{{ operator.name | first }}</span>{% endif %}
        </div>
      </div>
      <dl class="toplist-values">
        {% for key, label in {signup: "Free signup", purchase: "Purchase deal", daily: "Daily reward", redemption: "Published processing", cash: "Cash minimum"} %}
        <div class="toplist-metric" data-metric="{{ key }}"><dt>{{ label }}</dt><dd>{{ cell(operator[key]) }}</dd></div>
        {% endfor %}
      </dl>
      <div class="toplist-footer">
        <details class="toplist-sources">
          <summary>Terms</summary>
          <div class="toplist-evidence">
            {% for key, label in {signup: "Free signup", purchase: "Purchase deal", daily: "Daily reward", redemption: "Published processing", cash: "Cash minimum"} %}
            {% set value = operator[key] %}{% if value %}
              <section class="toplist-source" data-record-id="{{ value.recordId }}">
                <h4>{{ label }}</h4><a href="{{ value.sourceUrl | escape }}" rel="noopener">{{ value.label | escape }}</a>
                <span>Observed <time datetime="{{ value.observedAt }}">{{ value.observedAt | readableDate }}</time>{% if value.status == "retained" %} · Previous observation{% endif %}</span>
                {% if value.lastChangedAt %}<span>Change observed <time datetime="{{ value.lastChangedAt }}">{{ value.lastChangedAt | readableDate }}</time></span>{% endif %}
                {% if value.promoCode %}<span>Code: {{ value.promoCode | escape }}</span>{% endif %}
                {% if value.conditions.length %}<ul>{% for condition in value.conditions %}<li>{{ condition | escape }}</li>{% endfor %}</ul>{% endif %}
              </section>
            {% endif %}{% endfor %}
            <p>{{ operator.knownAttributeCount }} of 4 comparison categories supported. Signup and purchase deals form one offers category.</p>
            <a href="{{ operator.url }}">Full operator record</a>
          </div>
        </details>
        <a class="toplist-visit" href="{{ operator.visitUrl }}" aria-label="Visit {{ operator.name | escape }}"><span>Visit</span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </li>
    {% else %}<li>No operators currently meet the comparison requirements. <a href="/redemption-times/">Operator records</a></li>{% endfor %}
  </ol>
  <p class="toplist-footnote">SC = Sweepstakes Coins. Published times, not measured payouts. <a href="/bonuses/cash-redemption-minimums/">Compare cash minimums</a> · <a href="/methodology/#homepage-order">How we order the list</a> · <a href="/updates/">Daily checks</a></p>
</section>
<script type="module" src="/assets/toplist-sort.js"></script>
