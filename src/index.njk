<main>
<!-- Hero -->
<section class="hero-bg relative -mt-px flex min-h-[68vh] items-center">
  <div class="wrap py-16">
    <span class="badge complete mb-4"><i class="ph ph-shield-check" aria-hidden="true"></i> Independent &amp; player-first</span>
    <h1 class="mb-5 max-w-3xl font-serif text-[2.6rem] font-semibold leading-[1.06] text-white sm:text-[3.4rem]">Find trusted payout data and the best social casino deals.</h1>
    <p class="mb-8 max-w-xl text-lg leading-relaxed text-white/85">We time real redemptions, verify operator terms, and track who actually pays out — so you can pick a social casino with confidence. Every figure is dated and sourced.</p>
    <div class="flex flex-wrap gap-3">
      <a href="#deals" class="btn btn-primary"><i class="ph ph-cards" aria-hidden="true"></i> See top deals</a>
      <a href="/guides/" class="btn btn-outline border-white/40 text-white hover:bg-white/10 hover:border-white/60"><i class="ph ph-book-open" aria-hidden="true"></i> Read the research</a>
    </div>
  </div>
</section>

<div class="wrap py-2">

  <!-- Best deals & terms -->
  <section id="deals" class="scroll-mt-20 py-10" aria-labelledby="deals-heading">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
