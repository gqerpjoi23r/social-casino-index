        name: "Social Casino Index"
        publisher:
          "@id": "https://socialcasinoindex.com/#org"
      - "@type": "Person"
        "@id": "https://socialcasinoindex.com/#alex-rowan"
        name: "Alex Rowan"
        url: "https://socialcasinoindex.com/authors/alex-rowan/"
        description: "Editorial pen name used by the Social Casino Index research team."
        worksFor:
          "@id": "https://socialcasinoindex.com/#org"
      - "@type": "WebPage"
        "@id": "https://socialcasinoindex.com/#page"
        url: "https://socialcasinoindex.com/"
        name: "Social Casino Index"
        description: "Independent redemption times, verification requirements, and payout research for US sweepstakes casinos."
        isPartOf:
          "@id": "https://socialcasinoindex.com/#site"
        about:
          - "@type": "Thing"
