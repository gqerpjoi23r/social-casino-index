---
<main>
<section class="hero-bg relative -mt-px flex min-h-[64vh] items-center">
  <div class="wrap py-16">
    <span class="badge complete mb-4"><i class="ph ph-chart-bar" aria-hidden="true"></i> 10 operator records · checked September 2026</span>
    <h1 class="mb-5 max-w-3xl font-serif text-[2.6rem] font-semibold leading-[1.06] text-white sm:text-[3.4rem]">Compare what social casinos actually give players.</h1>
    <p class="mb-8 max-w-2xl text-lg leading-relaxed text-white/85">Offers, games, redemption methods, payout timing, minimums and restrictions in one dated, source-linked index. Unknown terms stay marked as unknown.</p>
    <div class="flex flex-wrap gap-3">
      <a href="#compare" class="btn btn-primary"><i class="ph ph-scales" aria-hidden="true"></i> Compare casinos</a>
      <a href="/redemption-times/" class="btn btn-outline border-white/40 text-white hover:border-white/60 hover:bg-white/10"><i class="ph ph-clock" aria-hidden="true"></i> Compare payouts</a>
    </div>
  </div>
</section>

<div class="wrap py-2">
  <section id="compare" class="scroll-mt-20 py-10" aria-labelledby="compare-heading">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="compare-heading" class="section-title">Social casino comparison</h2>
        <p class="m-0 max-w-2xl text-base-content/60">Start with the player outcome that matters to you. Partner status never changes the underlying data or verification label.</p>
      </div>
      <span class="badge pending">Records checked September 2026</span>
    </div>

    <div class="comparison-grid">
{% for op in operators %}
      <article class="operator-card">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="eyebrow">#{{ op.position }}</p>
            <h3><a href="/redemption-times/{{ op.slug }}/">{{ op.name }}</a></h3>
          </div>
          <span class="badge {% if op.verificationStatus == 'verified' %}complete{% else %}pending{% endif %}">{{ op.verificationLabel }}</span>
        </div>
        <p class="operator-fit">{{ op.bestFor }}</p>
        <dl class="fact-grid">
          <div><dt>Redemption</dt><dd>{{ op.publishedEstimate }}</dd></div>
          <div><dt>Methods</dt><dd>{{ op.methods }}</dd></div>
          <div><dt>Minimum</dt><dd>{{ op.minRedemption }}</dd></div>
          <div><dt>Games</dt><dd>{{ op.games }}</dd></div>
        </dl>
        <div class="operator-actions">
          <a class="btn btn-sm btn-outline" href="/redemption-times/{{ op.slug }}/">Full terms</a>
{% if op.partner %}
          <div class="cta-box !m-0 !border-0 !bg-transparent !p-0" data-cta-operator="{{ op.slug }}">
            <p class="cta-msg sr-only">Check state availability before visiting.</p>
            <a class="cta-btn btn btn-primary btn-sm" href="/go/{{ op.slug }}/">Visit {{ op.name }} <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
{% endif %}
        </div>
      </article>
{% endfor %}
    </div>
    <p class="mt-4 text-sm text-base-content/50">Partner links may earn us a commission. Data fields come from the cited operator sources and are not upgraded because of compensation.</p>
    <p class="mt-2 text-sm text-base-content/50"><i class="ph ph-seal-check" aria-hidden="true"></i> <strong class="text-base-content/70">What the verification badge means:</strong> it shows how much of an operator's record we confirmed from public terms or sweepstakes rules, not a rating or recommendation. Unknown terms remain explicitly unverified.</p>
  </section>

  <section class="py-10" aria-labelledby="choose-heading">
    <h2 id="choose-heading" class="section-title">Choose by player value</h2>
    <div class="value-links">
      <a href="/redemption-times/"><i class="ph ph-timer" aria-hidden="true"></i><span><strong>Fast and predictable redemptions</strong><small>Compare timing, minimums, methods and first-payout checks.</small></span></a>
      <a href="/guides/sweepstakes-casino-redemption-methods/"><i class="ph ph-bank" aria-hidden="true"></i><span><strong>Bank, gift card or crypto</strong><small>Match the payout method to your priorities.</small></span></a>
      <a href="/guides/sweepstakes-casino-real-prizes-rules/"><i class="ph ph-trophy" aria-hidden="true"></i><span><strong>How real-prize play works</strong><small>Understand currencies, playthrough and redemption.</small></span></a>
      <a href="/taxes/"><i class="ph ph-receipt" aria-hidden="true"></i><span><strong>Prize record keeping</strong><small>Track redemptions and prepare useful records for tax time.</small></span></a>
    </div>
  </section>

  <section class="py-10" aria-labelledby="data-heading">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="data-heading" class="section-title">The data behind the comparison</h2>
        <p class="m-0 text-base-content/60">One normalized record per operator, with a last-checked date and access-dated primary sources.</p>
      </div>
      <div class="flex gap-2">
        <a class="btn btn-sm btn-outline" href="/assets/data/operators-2026.1.json" download>JSON</a>
        <a class="btn btn-sm btn-outline" href="/assets/data/redemption-times-2026.1.csv" download>CSV</a>
      </div>
    </div>
    <div class="table-scroll">
      <table class="data">
        <thead><tr><th>Operator</th><th>Published timing</th><th>Methods</th><th>Minimum</th><th>Last checked</th></tr></thead>
        <tbody>
{% for op in operators %}
          <tr>
            <th><a href="/redemption-times/{{ op.slug }}/">{{ op.name }}</a></th>
            <td>{{ op.publishedEstimate }}</td>
            <td>{{ op.methods }}</td>
            <td>{{ op.minRedemption }}</td>
            <td>{{ op.verifiedAt | readableDate }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="eligibility scroll-mt-20" aria-labelledby="eligibility-heading">
    <h2 id="eligibility-heading"><i class="ph ph-map-pin" aria-hidden="true"></i> Check availability in your state</h2>
    <p>Select your state before following a commercial link. Each operator can apply additional restrictions.</p>
    <div class="js-only">
      <label for="state-picker" class="mb-1.5 block text-sm font-semibold text-base-content/60">Your state</label>
      <select id="state-picker" data-state-picker>
        {% for s in states %}<option value="{{ s.code }}"{% if not s.code %} disabled selected{% endif %}>{{ s.name }}</option>{% endfor %}
      </select>
      <p class="eligibility-note">Stored on this device for 30 days. Current selection: <strong data-state-echo>not selected</strong>.</p>
    </div>
    <noscript><p class="eligibility-note">State selection requires JavaScript. The <a href="/availability/">state availability list</a> works without it.</p></noscript>
  </section>
</div>
</main>
